# FNXC:Phase2A 2026-07-30-08:00:
# SYSTEMD_SERVICE_CONTEXT acceptance harness runner (fusion user, approved NoNewPrivileges=no).
# This is NOT the Fusion engine → task/agent child path. REAL_FUSION_ENGINE_CHILD_PATH remains NOT PROVEN in Phase 2A.
[Unit]
Description=Appsolino Fusion staging ACC-ENV systemd-context harness
After=network.target

[Service]
Type=oneshot
User={{ fusion_user }}
Group={{ fusion_group }}
UMask=0027
NoNewPrivileges=no
ProtectSystem=off
WorkingDirectory={{ staging_state }}
Environment=HOME={{ staging_fusion_home }}
Environment=FUSION_HOME={{ staging_fusion_home }}
EnvironmentFile={{ staging_env_file }}
EnvironmentFile={{ staging_secrets_file }}
ExecStart=/usr/local/sbin/run-staging-acceptance.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fusion-staging-acceptance-run
