    {
      "file": ".github/workflows/upstream-reliability-steward.yml",
      "name": "Upstream Reliability Steward",
      "status": "ACTIVE_CANONICAL",
      "triggers": ["workflow_run / schedule"],
      "notes": "Observability / steward plane — does not replace AUTO-2 finalize"
    }
  ],
  "candidateLease": {
